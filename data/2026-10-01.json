[{"id":"CVE-2026-47096","title":"AJA HELO Plus firmware before 2.1.7 contains a stored cross-site scripting vulnerability that allows unauthenticated attackers with network access to inject malicious JavaScript by","desc":"AJA HELO Plus firmware before 2.1.7 contains a stored cross-site scripting vulnerability that allows unauthenticated attackers with network access to inject malicious JavaScript by setting an unsanitized eParamID_SystemName value through the /config?action=set web configuration API. Attackers can exploit this flaw when device authentication is disabled to persistently execute arbitrary script in the browser of any administrator who opens the web management interface, enabling theft of stored secrets such as web UI credentials, RTMP stream keys, publish URLs, and NFS/SMB share credentials, as well as hijacking of the authenticated session.","score":5.3,"sev":"medium","published":"2026-09-30T22:16:33.720","modified":"2026-09-30T22:16:33.720","window_date":"2026-10-01","activity_at":"2026-10-01T00:32:49Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-47096","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-47096","source":"CVE Program"},{"label":"Reference","url":"https://d26ddnfpy9hzf8.cloudfront.net/aja-web/public/pdf/2026/AJA_HELO_PLUS_ReleaseNotes_v2.1.7.pdf","source":"NVD"},{"label":"Reference","url":"https://www.aja.com/security-advisories/aja-sa-2026-003","source":"NVD"},{"label":"Reference","url":"https://www.aja.com/support/item/10457","source":"NVD"},{"label":"Reference","url":"https://www.vulncheck.com/advisories/aja-helo-plus-stored-xss-via-system-name-parameter","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-374j-g8f5-7486","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-374j-g8f5-7486"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-47096"},{"id":"CVE-2026-103592","title":"simple-php-router through 5.4.1.7 contains an IP restriction bypass vulnerability in the IpRestrictAccess middleware that allows remote unauthenticated attackers to bypass IP white","desc":"simple-php-router through 5.4.1.7 contains an IP restriction bypass vulnerability in the IpRestrictAccess middleware that allows remote unauthenticated attackers to bypass IP whitelist and blacklist protections. Attackers can spoof X-Forwarded-For, CF-Connecting-IP, or Client-IP headers to impersonate whitelisted addresses or evade blacklists, gaining access to IP-restricted routes.","score":6.9,"sev":"medium","published":"2026-09-30T23:16:58.963","modified":"2026-09-30T23:16:58.963","window_date":"2026-10-01","activity_at":"2026-10-01T00:32:50Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-103592","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-103592","source":"CVE Program"},{"label":"Reference","url":"https://github.com/skipperbent/simple-php-router","source":"NVD"},{"label":"Reference","url":"https://github.com/skipperbent/simple-php-router/blob/5.4.1.7/src/Pecee/Http/Middleware/IpRestrictAccess.php","source":"NVD"},{"label":"Reference","url":"https://github.com/skipperbent/simple-php-router/blob/5.4.1.7/src/Pecee/Http/Request.php","source":"NVD"},{"label":"Reference","url":"https://github.com/skipperbent/simple-php-router/issues/727","source":"NVD"},{"label":"Reference","url":"https://www.vulncheck.com/advisories/simple-php-router-through-5.4.1.7-ip-restriction-bypass-via-forwarding-headers","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-73j7-rxg8-5ccm","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security A