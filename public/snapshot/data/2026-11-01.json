/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-835"]},{"id":"CVE-2026-120250","title":"OpenAlgo 1.0.0.29 before 2.0.3.1 contains an improper certificate validation vulnerability in utils/email_utils.py and utils/email_debug.py that disables TLS hostname and…","desc":"OpenAlgo 1.0.0.29 before 2.0.3.1 contains an improper certificate validation vulnerability in utils/email_utils.py and utils/email_debug.py that disables TLS hostname and certificate checks for STARTTLS and SMTPS. Network-positioned attackers can present a forged certificate to intercept SMTP credentials and all later mail, including password-reset links.","score":6.0,"sev":"medium","published":"2026-11-01T01:17:18.903Z","modified":"2026-11-01T01:17:18.903Z","window_date":"2026-11-01","activity_at":"2026-11-01T03:30:38Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-120250","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-120250","source":"CVE Program"},{"label":"Reference","url":"https://github.com/marketcalls/openalgo","source":"NVD"},{"label":"Reference","url":"https://github.com/marketcalls/openalgo/blob/96e5927e5adbff146f203bf72c7a79add9e6622c/utils/email_utils.py#L403-L406","source":"NVD"},{"label":"Reference","url":"https://github.com/marketcalls/openalgo/blob/main/docs/releases/version-2.0.3.1-released.md","source":"NVD"},{"label":"Reference","url":"https://github.com/marketcalls/openalgo/commit/af5d5f2cc564ee31cdd1159bc147a9b03cc713ac","source":"NVD"},{"label":"Reference","url":"https://www.vulncheck.com/advisories/openalgo-1.0.0.29-before-2.0.3.1-improper-certificate-validation-in-smtp-connections","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-pxjx-g7g8-jwq6","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-pxjx-g7g8-jwq6"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-120250","cvss_vector":"CVSS:4.0/AV:A/AC:H/AT:P/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-295"]},{"id":"CVE-2026-120249","title":"Thelia Back-office Default Twig Template before 1.1.1 contains a cross-site request forgery vulnerability in the /admin/product/combinations/update and…","desc":"Thelia Back-office Default Twig Template before 1.1.1 contains a cross-site request forgery vulnerability in the /admin/product/combinations/update and /admin/product/default-price/update routes, which accept GET requests without anti-CSRF token checks. Attackers can lure a logged-in administrator into following a crafted link to rewrite product combination prices, stock, weight, EAN and sale flags, zeroing omitted prices.","score":6.9,"sev":"medium","published":"2026-11-01T01:17:18.683Z","modified":"2026-11-01T01:17:18.683Z","window_date":"2026-11-01","activity_at":"2026-11-01T03:30:38Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-120249","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-120249","source":"CVE Program"},{"label":"Reference","url":"https://github.com/thelia-templates/default-twig/blob/6473c164bd86348f4c7d0ef6f194f1ff3d267902/src/Controller/Catalog/ProductAdvancedController.php#L546-L599","source":"NVD"},{"label":"Reference","url":"https://github.com/thelia-templates/default-twig/commit/51b014b06a5b4ee45f15093aa58a3064d4412bd3","source":"NVD"},{"label":"Reference","url":"https://github.com/thelia-templates/default-twig/commit/aaf540ca552dbc4c63dca77620af4b7936d22e8f","source":"NVD"},{"label":"Reference","url":"https://github.com/thelia/thelia/security/advisories/