R:N/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H/E:P/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-119","CWE-121"]},{"id":"CVE-2026-120185","title":"A security flaw has been discovered in ken678 YznCMS up to 2.2.0.","desc":"A security flaw has been discovered in ken678 YznCMS up to 2.2.0. The affected element is the function Backend of the file app/admin/controller/auth/Group.php of the component Auth Group Handler. Performing a manipulation results in improper privilege management. The attack can be initiated remotely. Upgrading to version 2.2.1 is sufficient to fix this issue. The patch is named ed16cd7f7f73e0316ffa8a148d. You should upgrade the affected component.","score":5.1,"sev":"medium","published":"2026-10-31T23:17:11.423Z","modified":"2026-10-31T23:17:11.423Z","window_date":"2026-11-01","activity_at":"2026-11-01T00:30:25Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-120185","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-120185","source":"CVE Program"},{"label":"Reference","url":"https://gitee.com/ken678/YZNCMS/","source":"NVD"},{"label":"Reference","url":"https://gitee.com/ken678/YZNCMS/commit/ed16cd7f7f73e0316ffa8a148d","source":"NVD"},{"label":"Reference","url":"https://gitee.com/ken678/YZNCMS/tree/v2.2.1","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/cve/CVE-2026-120185","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/submit/1026603","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/429502","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/429502/cti","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-r68q-24fh-c39p","source":"GitHub"},{"label":"Advisory reference","url":"https://gitee.com/ken678/YZNCMS","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-r68q-24fh-c39p"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-120185","cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-266","CWE-269"]},{"id":"CVE-2026-115946","title":"XS::libbrotli versions before 1.2.1.0 for Perl bundle a brotli library with an out-of-bounds write in the decoder.","desc":"XS::libbrotli versions before 1.2.1.0 for Perl bundle a brotli library with an out-of-bounds write in the decoder.\n\nAffected versions compile a bundled brotli into static archives that dependent XS modules link against at build time, rather than using the system library. The bundled copy, 1.0.7 or 1.1.0 across the range, carries the decoder out-of-bounds write described in CVE-2026-111497. Version 1.2.1.0 updates it to brotli 1.2.1.\n\nXS::libbrotli has no Perl interface, so the decoder is reached through any dependent module that decompresses untrusted data with it. An attacker supplying a crafted brotli stream can corrupt decoder state, disclose memory, crash the process, or potentially execute arbitrary code. Upgrading the system brotli does not remediate this.","score":0.0,"sev":"none","published":"2026-11-01T00:16:34.437Z","modified":"2026-11-01T00:16:34.437Z","window_date":"2026-11-01","activity_at":"2026-11-01T00:30:25Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-115946","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-115946","source":"CVE Program"},{"label":"Reference","url":"https://github.com/google/brotli/releases/tag/v1.2.1","source":"NVD"},{"label":"Reference","url":"https://metacpan.org/release/SYBER/XS-libbrotli-1.2.1.0/changes","source":"NVD"},{"label":"Reference","url":"https://www.cve.org/CVERecord?id=CVE-2026-111497","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-3jf5-xc4h-mr9m","source":"GitHub"}],"related_cves":[{"id":"CVE-2026-111497","url":"https://www.cve.org/CVERecord?id=CVE-2026-111497","source":"NVD reference"}],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-3jf5-xc4h-mr9m"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-115946"}]
