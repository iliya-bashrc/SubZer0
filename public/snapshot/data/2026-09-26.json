rl":"https://www.cve.org/CVERecord?id=CVE-2026-82294","source":"CVE Program"},{"label":"Reference","url":"https://discuss.elastic.co/t/elasticsearch-8-19-21-9-4-6-9-5-3-security-update-esa-2026-170/390681","source":"NVD","tags":["Vendor Advisory"]},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-8xp9-rcqv-cqmq","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-8xp9-rcqv-cqmq"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-82294","cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H","cwe":["CWE-400"]},{"id":"CVE-2026-78582","title":"Missing Authorization (CWE-862) in Kibana can lead to unauthorized deletion of data via Exploiting Incorrectly Configured Access Control Security Levels (CAPEC-180).","desc":"Missing Authorization (CWE-862) in Kibana can lead to unauthorized deletion of data via Exploiting Incorrectly Configured Access Control Security Levels (CAPEC-180). An authenticated user holding Synthetics privileges scoped to a single Kibana space could permanently delete Synthetics monitors that are shared into spaces they have no access to. Where a monitor is associated with a private location, the same operation also destroys the underlying Elastic Agent integration configuration without the authorization checks that Fleet would otherwise apply.","score":6.5,"sev":"medium","published":"2026-09-26T21:16:55.663Z","modified":"2026-09-28T16:31:47.727Z","window_date":"2026-09-26","activity_at":"2026-09-26T21:30:27Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-78582","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-78582","source":"CVE Program"},{"label":"Reference","url":"https://discuss.elastic.co/t/kibana-8-19-22-9-4-7-9-5-3-security-update-esa-2026-139/390680","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-8638-62wr-x98m","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-8638-62wr-x98m"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-78582","cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","cwe":["CWE-862"]},{"id":"CVE-2026-72668","title":"Unintended Proxy or Intermediary ('Confused Deputy') (CWE-441) in Kibana Agent Builder can lead to privilege escalation.","desc":"Unintended Proxy or Intermediary ('Confused Deputy') (CWE-441) in Kibana Agent Builder can lead to privilege escalation. A non-administrative user able to edit a shared agent could cause privileged operations to be carried out under the identity of a higher-privileged user who subsequently interacts with that agent. Where the same user can also author workflows, this can extend to full administrative control of Kibana and of the Elasticsearch cluster.","score":7.3,"sev":"high","published":"2026-09-26T21:16:55.540Z","modified":"2026-09-29T04:17:57.373Z","window_date":"2026-09-26","activity_at":"2026-09-26T21:30:27Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-72668","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-72668","source":"CVE Program"},{"label":"Reference","url":"https://discuss.elastic.co/t/kibana-9-4-7-9-5-0-security-update-esa-2026-85/390678","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-r4ff-jqf2-8p5g","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-r4ff-jqf2-8p5g"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-72668","cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:N","cwe":["CWE-441"]},{"id":"CVE-2026-72662","title":"Authorization Bypass Through User-Controlled Key (CWE-639) in Kibana can lead to unauthorized disclosure, modification, and deletion of data via Accessing Functionality Not…","desc":"Authorization Bypass Through User-Controlled Key (CWE-639) in Kibana can lead to unauthorized disclosure, modification, and deletion of data via Accessing Functionality Not Properly Constrained by ACLs (CAPEC-1). An authenticated user granted the Timeline feature privilege in a Kibana space could enumerate, read, modify, and delete draft Timeline objects belonging to other users in the same space. Read access is sufficient for enumeration and disclosure; the Timeline write privilege is required for modification and deletion.","score":6.3,"sev":"medium","published":"2026-09-26T21:16:55.410Z","modified":"2026-09-28T16:31:47.727Z","window_date":"2026-09-26","activity_at":"2026-09-26T21:30:27Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-72662","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-72662","source":"CVE Program"},{"label":"Reference","url":"https://discuss.elastic.co/t/kibana-8-19-22-9-4-6-security-update-esa-2026-103/390679","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-hgww-7pvf-x93v","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-hgww-7pvf-x93v"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-72662","cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:L","cwe":["CWE-639"]}]
