2026-111493","cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-306"]},{"id":"CVE-2026-111492","title":"SQL injection in the push notification handler of the MatchPoint Android app, which processes messages from Firebase Cloud Messaging and constructs queries by concatenating…","desc":"SQL injection in the push notification handler of the MatchPoint Android app, which processes messages from Firebase Cloud Messaging and constructs queries by concatenating untrusted data. An attacker capable of interacting with the component could manipulate queries and access sensitive information from the local database, including credentials stored in the versions described in the report. The scope of the injection is limited to the device.","score":8.6,"sev":"high","published":"2026-11-05T22:17:43.887Z","modified":"2026-11-05T22:36:02.320Z","window_date":"2026-11-06","activity_at":"2026-11-06T00:32:44Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-111492","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-111492","source":"CVE Program"},{"label":"Reference","url":"https://www.incibe.es/en/incibe-cert/notices/aviso/multiple-vulnerabilities-tpc-softwares-matchpoint","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-hg5v-m73p-68rg","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-hg5v-m73p-68rg"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-111492","cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-89"]},{"id":"CVE-2026-111491","title":"Credentials are stored in plain text in an SQLite database and in the MatchPoint Android app's SharedPreferences.","desc":"Credentials are stored in plain text in an SQLite database and in the MatchPoint Android app's SharedPreferences. An attacker with access to the device's local data or a backup could retrieve usernames and passwords and use them to gain unauthorized access to accounts on the platform.","score":6.9,"sev":"medium","published":"2026-11-05T22:17:43.743Z","modified":"2026-11-05T22:36:02.320Z","window_date":"2026-11-06","activity_at":"2026-11-06T00:32:44Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-111491","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-111491","source":"CVE Program"},{"label":"Reference","url":"https://www.incibe.es/en/incibe-cert/notices/aviso/multiple-vulnerabilities-tpc-softwares-matchpoint","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-qfj6-7j4w-m5pv","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-qfj6-7j4w-m5pv"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-111491","cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-256"]},{"id":"CVE-2026-111490","title":"Insecure direct object reference (IDOR) vulnerability in the MatchPoint API, which relies on the `actingasuser` HTTP header without verifying the requester's authorization for…","desc":"Insecure direct object reference (IDOR) vulnerability in the MatchPoint API, which relies on the `actingasuser` HTTP header without veri