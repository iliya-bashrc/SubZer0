[{"id":"CVE-2026-77299","title":"Regexp2 is a feature-rich RegExp engine for Go.","desc":"Regexp2 is a feature-rich RegExp engine for Go. Prior to version 2.3.0, when regexp2 compiles and matches a pattern containing a large fixed-count quantifier applied to a zero-width subexpression — e.g. (?:){50000000} — the match engine executes the empty loop body m-1 times, pushing two integers onto the backtracking stack on every iteration. Because the parser accepts any repetition count up to math.MaxInt32 and the backtracking stack grows without bound, a pattern of fewer than 20 bytes matched against an empty input can force multi-gigabyte allocation and OOM-kill the process. MatchTimeout does not fully mitigate this because the memory is allocated faster than the 100 ms timeout clock can fire. This issue has been patched in version 2.3.0.","score":7.5,"sev":"high","published":"2026-11-06T02:17:52.893Z","modified":"2026-11-06T02:17:52.893Z","window_date":"2026-11-06","activity_at":"2026-11-06T02:17:52.893Z","date_basis":"CVE publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-77299","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-77299","source":"CVE Program"},{"label":"Reference","url":"https://github.com/dlclark/regexp2/commit/6e446cb3a57a0f20112bc24353604fd00bdb309a","source":"NVD"},{"label":"Reference","url":"https://github.com/dlclark/regexp2/releases/tag/v2.3.0","source":"NVD"},{"label":"Reference","url":"https://github.com/dlclark/regexp2/security/advisories/GHSA-wq9v-j77v-qr26","source":"NVD"}],"related_cves":[],"advisories":[],"sources":["NVD"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-77299","cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","cwe":["CWE-400","CWE-770"]},{"id":"CVE-2026-63774","title":"Insufficient input validation in the PowerSYSTEM Center report designer allows an authenticated user to execute unauthorized SQL 