2026-123269","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/submit/1032842","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/431575","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/431575/cti","source":"NVD"}],"related_cves":[],"advisories":[],"sources":["NVD"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-123269","cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N/E:P/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-119","CWE-125"]},{"id":"CVE-2026-123268","title":"A security vulnerability has been detected in libyal libvmdk up to 3fdd7839758e9f44ef95e1dfccde8552b860a4fc.","desc":"A security vulnerability has been detected in libyal libvmdk up to 3fdd7839758e9f44ef95e1dfccde8552b860a4fc. Affected is the function libvmdk_extent_table_get_extent_data_file_path of the file libvmdk/libvmdk_extent_table.c of the component Extent Data File Handler. The manipulation leads to memory corruption. The attack may be initiated remotely. The exploit has been disclosed publicly and may be used. This product uses a rolling release model to deliver continuous updates. As a result, specific version information for affected or updated releases is not available. The identifier of the patch is 175d3fc0a0b961f362f16e7560a6169d7213e16b. Applying a patch is the recommended action to fix this issue.","score":2.0,"sev":"low","published":"2026-11-06T01:17:48.573Z","modified":"2026-11-06T01:17:48.730Z","window_date":"2026-11-06","activity_at":"2026-11-06T01:17:48.573Z","date_basis":"CVE publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-123268","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-123268","source":"CVE Program"},{"label":"Reference","url":"https://github.com/libyal/libvmdk/","source":"NVD"},{"label":"Reference","