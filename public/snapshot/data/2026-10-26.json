":"https://vuldb.com/vuln/426165","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/426165/cti","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-rwj8-54ch-cv2w","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-rwj8-54ch-cv2w"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116097","cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N/E:P/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-79","CWE-94"]},{"id":"CVE-2026-116096","title":"A weakness has been identified in ggml-org llama.cpp.","desc":"A weakness has been identified in ggml-org llama.cpp. Affected by this issue is the function list_pockettts_state_slots of the file tools/mtmd/models/pockettts-gen.cpp of the component Pocket-TTS. This manipulation of the argument mmproj causes out-of-bounds write. The attack requires local access. The exploit has been made available to the public and could be used for attacks. Upgrading to version b11796 can resolve this issue. Patch name: 0a1ef309cdbb9f2024f58a38fb4c42352c5db569. The affected component should be upgraded. The reported heap out‑of‑bounds write (gen‑audio / pocket‑tts state_out path) is no longer a silent exploitable heap write on current master and the latest release b11871 - a malicious mmproj that previously triggered it now trips a release‑active GGML_ASSERT and aborts. But the submitter's recommended by‑construction fix (PR #29360 \"prevent OOB accesses from malformed mmproj files\") is still open. So the root cause is detected‑and‑aborted, not prevented‑by‑design.","score":1.9,"sev":"low","published":"2026-10-25T23:17:41.897Z","modified":"2026-10-25T23:17:41.897Z","window_date":"2026-10-26","activity_at":"2026-10-26T00:32:48Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116096","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-116096","source":"CVE Program"},{"label":"Reference","url":"https://github.com/3em0/cve_repo/tree/main/2026/llama.cpp.pockettts_state_heap_oob_rce","source":"NVD"},{"label":"Reference","url":"https://github.com/3em0/cve_repo/tree/main/2026/llama.cpp.pockettts_state_heap_oob_rce/poc","source":"NVD"},{"label":"Reference","url":"https://github.com/ggml-org/llama.cpp/","source":"NVD"},{"label":"Reference","url":"https://github.com/ggml-org/llama.cpp/commit/0a1ef309cdbb9f2024f58a38fb4c42352c5db569","source":"NVD"},{"label":"Reference","url":"https://github.com/ggml-org/llama.cpp/pull/30902","source":"NVD"},{"label":"Reference","url":"https://github.com/ggml-org/llama.cpp/releases/tag/b11796","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/cve/CVE-2026-116096","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/submit/1000891","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/426164","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/426164/cti","source":"NVD"},{"label":"GitHub security advisory","url":"https://github.com/advisories/GHSA-w879-pch3-42x5","source":"GitHub"},{"label":"Advisory reference","url":"https://github.com/ggml-org/llama.cpp","source":"GitHub"}],"related_cves":[],"advisories":[{"label":"GitHub Security Advisory","url":"https://github.com/advisories/GHSA-w879-pch3-42x5"}],"sources":["NVD","GitHub Advisory Database"],"kev":null,"primary_url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116096","cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N/E:P/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","cwe":["CWE-119","CWE-787"]},{"id":"CVE-2026-116095","title":"A vulnerability was identified in smg-project smg 1.7.0/1.8.0/1.9.0/1.10.0/1.10.1.","desc":"A vulnerability was identified in smg-project smg 1.7.0/1.8.0/1.9.0/1.10.0/1.10.1. Affected is the function jpeg_turbo::decode_jpeg_rgb of the file crates/multimodal/src/jpeg_turbo.rs of the component llm-multimodal. The manipulation leads to uncontrolled memory allocation. The attack can be initiated remotely. The exploit is publicly available and might be used. Upgrading to version 1.11.0 is able to address this issue. The identifier of the patch is 8f51b57e219a914089e345b704c3c8de37a3bb8e. It is advisable to upgrade the affected component.","score":5.5,"sev":"medium","published":"2026-10-25T23:17:41.220Z","modified":"2026-10-25T23:17:41.220Z","window_date":"2026-10-26","activity_at":"2026-10-26T00:32:48Z","date_basis":"GitHub advisory publication","affected":[],"refs":[{"label":"NVD record","url":"https://nvd.nist.gov/vuln/detail/CVE-2026-116095","source":"NVD"},{"label":"CVE Program record","url":"https://www.cve.org/CVERecord?id=CVE-2026-116095","source":"CVE Program"},{"label":"Reference","url":"https://gist.github.com/Yunzez/24a1bf4c226fbc324ea8da1d202c6d9b","source":"NVD"},{"label":"Reference","url":"https://github.com/smg-project/smg/","source":"NVD"},{"label":"Reference","url":"https://github.com/smg-project/smg/commit/8f51b57e219a914089e345b704c3c8de37a3bb8e","source":"NVD"},{"label":"Reference","url":"https://github.com/smg-project/smg/issues/2361","source":"NVD"},{"label":"Reference","url":"https://github.com/smg-project/smg/pull/2569","source":"NVD"},{"label":"Reference","url":"https://github.com/smg-project/smg/releases/tag/v1.11.0","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/cve/CVE-2026-116095","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/submit/1000796","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/426162","source":"NVD"},{"label":"Reference","url":"https://vuldb.com/vuln/426162/cti","source":"NVD"},{"label":"GitHub security advisory","url":"https://g