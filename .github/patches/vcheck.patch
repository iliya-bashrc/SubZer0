+const VER_RE=/^v?[0-9][0-9a-z.\-_+~]*$/i;
+const vnorm=s=>String(s||'').toLowerCase().replace(/_/g,' ').replace(/[^a-z0-9.+ ]/g,' ').replace(/\s+/g,' ').trim();
